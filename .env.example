# Copy to .env on the server (or .env.local for development) and fill in.
# Never commit the real file.

# The public address, e.g. https://mismo.example.com (http://localhost:3000 in development)
BETTER_AUTH_URL=
# Long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The owner's email. Everyone else signs in by invite.
OWNER_EMAIL=

# Database password for the bundled Postgres (docker compose). Not needed in development.
POSTGRES_PASSWORD=

# Email through Resend. Without a key, emails print to the server log.
RESEND_API_KEY=
EMAIL_FROM="Mismo <noreply@mismo.example.com>"
# Where replies go when no person caused the email (reminders, sign-in links).
# Emails a person triggers (invites, task assignments) reply to that person.
EMAIL_REPLY_TO=you@example.com

# Optional "Sign in with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone alerts (Web Push). Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: where the house is, so the sign-in scene follows the live weather there
# (Open-Meteo, free, no key). Two decimal places is plenty; it's rounded to that before
# it's sent and never reaches the browser. Without these the scene follows the clock only.
WEATHER_LAT=
WEATHER_LON=

# Set to "off" to stop the reminder scheduler (it runs every 5 minutes inside the app).
SCHEDULER=
